{
  "model_path": "",
  "search_roots": [
    "models",
    "hardware/artifacts",
    "~/person_detector_candidate/model",
    "/mnt/utm"
  ],
  "filename_patterns": [
    "*yolo*.onnx",
    "*yolo*.tflite",
    "*yolo*.pt",
    "*yolo*.pth",
    "*yolo*.h5",
    "*yolo*.keras"
  ],
  "target": {
    "input_width": 160,
    "input_height": 128,
    "input_channels": 1,
    "input_color": "grayscale",
    "preferred_format": "tflite-int8"
  },
  "compiler": {
    "path": "~/venvs/colibry-compiler/bin/nnpa-compiler",
    "command": [
      "{compiler}",
      "{model}",
      "--verbose"
    ],
    "output_dir": "~/models/colibry_yolo/compiler_test",
    "timeout_seconds": 300
  }
}
